      "name": "dispute-intent-classifier-v3"
    }
  ],
  "tools": [
    {
      "tool_id": "txn-read",
      "name": "Transaction lookup",
      "description": "Read transaction history for an account tied to an open dispute.",
      "data_access": "read",
      "permission_scope": "Accounts with an open dispute case only; 90-day transaction window.",
      "requires_approval": false,
      "reversibility": "reversible"
    },
    {
      "tool_id": "profile-read",
      "name": "Customer profile lookup",
      "description": "Read customer profile fields needed to verify dispute eligibility.",
      "data_access": "read",
      "permission_scope": "Disputing customer only; excludes SSN and full PAN.",
      "requires_approval": false,
      "reversibility": "reversible"
    },
    {
      "tool_id": "provisional-credit",
      "name": "Issue provisional credit",
      "description": "Post a provisional credit to the disputing account pending investigation.",
      "data_access": "write",
      "permission_scope": "Single account; amount governed by the credit-limit decision boundary.",
      "requires_approval": true,
      "reversibility": "reversible_with_effort",
      "rate_limit": "20 per hour",
      "threat_refs": ["AML.T0051", "AML.T0110"]
    },
    {
      "tool_id": "case-open",
      "name": "Open case in case-management system",
      "description": "Create or update a dispute case record for human follow-up.",
      "data_access": "write",
      "permission_scope": "Dispute case queue only.",
      "requires_approval": false,
      "reversibility": "reversible"
    }
  ],
  "decision_boundaries": [
    {
      "id": "credit-limit",
      "type": "limit",
      "description": "Provisional credit may be issued autonomously only up to $500. Above that, approval is required.",
      "threshold": "$500",
      "on_breach": "escalate"
    },
    {
      "id": "account-scope",
      "type": "deny",
      "description": "The agent may not read or write any account that is not tied to an open dispute it is handling.",
      "on_breach": "block"
    },
    {
      "id": "no-pii-export",
      "type": "deny",
      "description": "The agent may not transmit customer PII to any destination outside the dispute-platform trust boundary.",
      "on_breach": "halt"
    },
    {
      "id": "confidence-floor",
      "type": "limit",
      "description": "Disputes classified with confidence below 0.70 must be routed to a human rather than auto-resolved.",
      "threshold": "confidence < 0.70",
      "on_breach": "escalate"
    }
  ],
  "escalation": {
    "triggers": [
      { "condition": "Provisional credit amount exceeds $500", "action": "require_approval", "target": "fraud_analyst_queue", "sla": "4 business hours" },
      { "condition": "Transaction carries a fraud flag", "action": "escalate_to_human", "target": "fraud_analyst_queue", "sla": "1 business hour" },
      { "condition": "Classification confidence below 0.70", "action": "escalate_to_human", "target": "dispute_analyst_queue", "sla": "1 business day" }
    ],
    "kill_switch": {
      "available": true,
      "mechanism": "Feature flag agent.dispute_triage.enabled = false (LaunchDarkly); halts all autonomous action within 60s.",
      "owner": "ML Platform on-call"
    }
  },
